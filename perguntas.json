  "descritiva": [
    {
      "id": "01",
      "pergunta": "O que é deadlock? Cite 2 condições.",
      "resposta_certa": "Processos travados esperando recursos. Condições: Exclusão Mútua, Posse e Espera, Não Preempção, Espera Circular."
    },
    {
      "id": "02",
      "pergunta": "Vantagem de threads sobre processos na concorrência?",
      "resposta_certa": "Compartilhamento de memória eficiente e menor custo de comunicação/criação."
    },
    {
      "id": "03",
      "pergunta": "Cite e explique 2 comandos Linux essenciais.",
      "resposta_certa": "Ex: 'ls' (listar), 'cd' (mudar diretório), 'mkdir' (criar diretório), 'rm' (remover), 'cp' (copiar), 'mv' (mover/renomear), 'cat' (ver conteúdo)."
    },
    {
      "id": "04",
      "pergunta": "Por que o gerenciamento de memória é crucial?",
      "resposta_certa": "Garante alocação eficiente de RAM, previne interferência entre programas e otimiza uso."
    },
    {
      "id": "05",
      "pergunta": "Diferença: modo kernel e modo usuário?",
      "resposta_certa": "Kernel: acesso total (SO). Usuário: acesso restrito (aplicativos). Protege o sistema."
    },
    {
      "id": "06",
      "pergunta": "Qual a função do escalonador de CPU?",
      "resposta_certa": "Decidir qual processo/thread usará a CPU e por quanto tempo."
    },
    {
      "id": "07",
      "pergunta": "O que é CLI? Vantagem/Desvantagem.",
      "resposta_certa": "Interface de Linha de Comando (texto). Vantagem: automação. Desvantagem: exige memorização."
    },
    {
      "id": "08",
      "pergunta": "Para que serve a sincronização de threads?",
      "resposta_certa": "Coordenar acesso a recursos compartilhados, evitando erros (condições de corrida)."
    },
    {
      "id": "09",
      "pergunta": "Diferença: RAM e memória virtual.",
      "resposta_certa": "RAM: memória física principal. Virtual: usa disco como RAM extra, é mais lenta."
    },
    {
      "id": "10",
      "pergunta": "Cite e explique 1 método de prevenção de deadlock.",
      "resposta_certa": "Ex: Quebrar Espera Circular (definir ordem de recursos) ou Não Preempção (SO pode tirar recurso)."
    }
  ]
